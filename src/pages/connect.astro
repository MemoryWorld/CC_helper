---
import BaseLayout from "../layouts/BaseLayout.astro";
import { connectChannels, prerequisites, profile, scopeNotice } from "../data/site";

const icons: Record<string, string> = {
  calendar: '<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/><path d="m9 15 2 2 4-4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  wechat: '<path d="M8.5 5C4.91 5 2 7.46 2 10.5c0 1.69.9 3.2 2.31 4.2L3.5 17l2.5-1.3c.79.2 1.63.3 2.5.3.17 0 .33 0 .5-.02"/><circle cx="6.3" cy="9.5" r=".8" fill="currentColor"/><circle cx="10.7" cy="9.5" r=".8" fill="currentColor"/><path d="M22 15c0-2.5-2.46-4.5-5.5-4.5S11 12.5 11 15s2.46 4.5 5.5 4.5c.7 0 1.37-.1 1.99-.28L20.5 20l-.6-1.4A4.3 4.3 0 0 0 22 15Z"/><circle cx="14.8" cy="14.2" r=".7" fill="currentColor"/><circle cx="18.2" cy="14.2" r=".7" fill="currentColor"/>',
  telegram: '<path d="m22 3-9.5 9.5"/><path d="M22 3 15 21l-4-8-8-4Z"/>'
};
const ic = (n: string) => icons[n] ?? "";

const mailTemplate = [
  "你好 Ricardo，我想咨询 Claude Code 服务：",
  "",
  "1. 所在国家/城市：",
  "2. 操作系统（macOS / Windows / Linux）：",
  "3. 是否已有 Claude 订阅或 API Key：",
  "4. 想要的方案（安装配置 / MCP 工作流 / 团队 / 包月）：",
  "5. 主要用途或项目技术栈：",
  "6. 方便的时间（含时区）："
].join("\n");
const mailHref = `mailto:${profile.email}?subject=${encodeURIComponent("Claude Code 咨询")}&body=${encodeURIComponent(mailTemplate)}`;
---

<BaseLayout
  title={`预约咨询 | ${profile.name}`}
  description="预约免费 15 分钟评估：在线预约、邮件、微信或 Telegram / WhatsApp 联系 Ricardo，咨询 Claude Code 安装配置与工作流服务。"
  currentPath="/connect"
>
  <main class="container">
    <section class="page-hero section">
      <span class="eyebrow">Book a Call</span>
      <h1>预约免费 15 分钟评估</h1>
      <p>
        评估时我会确认你的系统环境、所在地区和需求，然后推荐合适的方案并报价。确认合适再付款，不合适也不收费。
        通常 24 小时内回复（{profile.location}）。
      </p>
    </section>

    <section class="section channel-grid">
      {connectChannels.map((c) => (
        <article class="channel-card">
          <span class="channel-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ic(c.icon)} />
          </span>
          <strong class="channel-name">{c.name}</strong>
          <p class="channel-desc">{c.desc}</p>
          {c.href ? (
            <a class="btn btn-primary channel-action" href={c.icon === "mail" ? mailHref : c.href} target={c.icon === "mail" ? undefined : "_blank"} rel="noopener noreferrer">{c.value}</a>
          ) : c.qr ? (
            <button type="button" class="btn btn-primary channel-action" data-qr={c.qr} data-qr-title={c.name}>{c.value}</button>
          ) : c.copy ? (
            <button type="button" class="channel-value" data-copy-text={c.value}>
              <span>{c.value}</span>
              <span class="channel-copy">复制</span>
            </button>
          ) : (
            <span class="channel-value channel-value-static">{c.value}</span>
          )}
        </article>
      ))}
    </section>

    <section class="section two-column">
      <div class="panel">
        <span class="eyebrow">联系时请告诉我</span>
        <ul class="list">
          <li>所在国家 / 城市与时区</li>
          <li>操作系统（macOS / Windows / Linux）</li>
          <li>是否已有 Claude 订阅或 API Key</li>
          <li>想要的方案和主要用途</li>
        </ul>
        <div class="button-row">
          <a class="btn btn-primary" href={mailHref}>用邮件模板联系</a>
          <a class="btn btn-secondary" href="/services">再看看方案</a>
        </div>
      </div>
      <div class="panel">
        <span class="eyebrow">开始前请准备</span>
        <ul class="list">
          {prerequisites.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="quote-box">
        <span class="eyebrow">{scopeNotice.title}</span>
        <ul class="list">
          {scopeNotice.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </section>
  </main>

  <div class="qr-modal" id="qrModal" hidden>
    <div class="qr-modal-backdrop" data-qr-close></div>
    <div class="qr-modal-box" role="dialog" aria-modal="true">
      <button type="button" class="qr-modal-close" data-qr-close aria-label="关闭">×</button>
      <strong class="qr-modal-title"></strong>
      <img class="qr-modal-img" src="" alt="二维码" />
      <p class="qr-modal-tip">微信扫一扫添加，备注「Claude」+ 所在国家</p>
    </div>
  </div>

  <script is:inline data-astro-rerun>
    (() => {
      const modal = document.getElementById("qrModal");
      if (!modal) return;
      const modalImg = modal.querySelector(".qr-modal-img");
      const modalTitle = modal.querySelector(".qr-modal-title");
      const openModal = (src, title) => {
        modalImg.src = src;
        modalTitle.textContent = title || "二维码";
        modal.hidden = false;
        document.body.style.overflow = "hidden";
      };
      const closeModal = () => { modal.hidden = true; document.body.style.overflow = ""; };
      document.querySelectorAll("[data-qr]").forEach((btn) => {
        btn.addEventListener("click", () => openModal(btn.getAttribute("data-qr"), btn.getAttribute("data-qr-title")));
      });
      modal.querySelectorAll("[data-qr-close]").forEach((el) => el.addEventListener("click", closeModal));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) closeModal(); });

      document.querySelectorAll("[data-copy-text]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = btn.getAttribute("data-copy-text");
          const tag = btn.querySelector(".channel-copy");
          try {
            await navigator.clipboard.writeText(text);
            if (tag) { const old = tag.textContent; tag.textContent = "已复制"; setTimeout(() => (tag.textContent = old), 1600); }
          } catch (e) {}
        });
      });
    })();
  </script>
</BaseLayout>
